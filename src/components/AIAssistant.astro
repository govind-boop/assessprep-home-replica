---
import { url } from '../data/site';
---
<section class="ai" id="ai">
  <div class="ai__head">
    <span class="ai__badge"><span>AI Assistant</span></span>
    <h2 class="ai__title">AssessPrep AI</h2>
    <p class="ai__sub">Experience the future of assessments with your own AI assistant!</p>
    <a class="ai__btn" href={url('features/ai')}>Learn more</a>
  </div>

  <!-- Bento: authored at 1200x900 (like the Framer original) and scaled down uniformly on smaller screens -->
  <div class="bento-wrap" data-bento-wrap>
    <div class="bento" data-bento>
      <!-- Right column: toggle -->
      <div class="b-card" style="left:906px;top:32px;width:262px;height:157px">
        <img class="b-bg" src="/images/ai-card-toggle.png" alt="Toggle button to switch AI assistant on" />
        <div class="b-toggle">
          <span class="b-knob" data-knob>
            <img src="/images/ai-knob-orange.png" alt="" />
            <img class="b-knob__icon" src="/icons/ai-stars.svg" alt="" />
          </span>
        </div>
      </div>

      <!-- Right column: 500K -->
      <div class="b-card" style="left:906px;top:217px;width:262px;height:211px">
        <img class="b-bg" src="/images/ai-card-500k.png" alt="500K questions generated block" />
        <p class="b-big b-grad-purple" style="left:65px;top:45px;width:132px">500K</p>
        <div class="b-prompt" style="left:32px;top:125px">
          <img class="b-bracket" src="/icons/ai-bracket.svg" alt="" />
          <span>questions generated</span>
          <img class="b-bracket b-bracket--r" src="/icons/ai-bracket.svg" alt="" />
        </div>
      </div>

      <!-- Centre: sphere (behind the cards; shows through the arch cut-outs) -->
      <div class="b-sphere" aria-hidden="true">
        <img class="b-sphere__glow" src="/images/ai-sphere-glow.png" alt="" />
        <img class="b-sphere__img" src="/images/ai-sphere.png" alt="AssessPrep AI globe" />
      </div>

      <img class="b-abs" src="/images/ai-card-teaching-assistant.png" alt="Your Teaching Assistant block" style="left:322px;top:32px;width:556px;height:396px" />

      <!-- Left column: authoring -->
      <div class="b-card" style="left:32px;top:32px;width:262px;height:396px">
        <img class="b-bg" src="/images/ai-card-authoring.png" alt="AssessPrep AI assistant generating questions" />
        <img class="b-abs" src="/icons/ai-sparkles.svg" alt="" style="left:32px;top:32px;width:40px;height:42px" />
        <p class="b-auth b-grad-white">AI<br />assisted<br />authoring</p>
        <div class="b-txt" style="left:32px;top:288px;width:170px">
          <p class="b-txt__t">Generate</p>
          <p class="b-txt__d">high quality questions<br />&amp; mark schemes</p>
        </div>
      </div>

      <!-- Left column: 2hrs -->
      <div class="b-card" style="left:32px;top:456px;width:262px;height:220px">
        <img class="b-bg" src="/images/ai-card-2hrs.png" alt="Block showing 2 hours saved per assessment" />
        <p class="b-big b-grad-orange" style="left:32px;top:25px;width:198px">2hrs</p>
        <p class="b-saved">saved per assessment</p>
        <div class="b-avatars">
          <img src="/images/ai-avatar-1.png" alt="" class="b-av" />
          <img src="/icons/ai-circle-star.svg" alt="" class="b-av b-av--star" />
          <img src="/images/ai-avatar-2.png" alt="" class="b-av" />
        </div>
      </div>

      <!-- Left column: Generate -->
      <div class="b-card" style="left:32px;top:704px;width:262px;height:164px">
        <img class="b-bg" src="/images/ai-card-generate.png" alt="" />
        <div class="b-gen">
          <span class="b-gen__btn">
            <img class="b-gen__bg" src="/images/ai-generate-button.png" alt="" />
            <img class="b-gen__icon" src="/icons/ai-generate.svg" alt="" />
            <span>Generate</span>
          </span>
        </div>
      </div>

      <!-- Centre bottom: grading + translate (text baked into artwork) -->
      <img class="b-abs" src="/images/ai-card-grading.png" alt="AI-powered grading: auto-grade typed and handwritten submissions" style="left:322px;top:456px;width:264px;height:412px" />
      <img class="b-abs" src="/images/ai-card-translate.png" alt="Translate assessments into any language with one click" style="left:614px;top:456px;width:264px;height:412px" />

      <!-- Right column: writing assistant -->
      <div class="b-card" style="left:906px;top:456px;width:262px;height:412px">
        <img class="b-bg" src="/images/ai-card-writing.png" alt="AI writing assistant block" />
        <div class="b-txt" style="left:32px;top:28px;width:198px">
          <p class="b-txt__t">AI writing assistant</p>
          <p class="b-txt__d">Enhance, convert, and translate with ease</p>
        </div>
        <div class="b-chip b-chip--v" style="left:186px;top:192px">
          <span>Improve clarity</span><i></i>
        </div>
        <img class="b-abs" src="/icons/ai-frame-wand.svg" alt="" style="left:79px;top:288px;width:109px;height:100px" />
        <img class="b-abs" src="/icons/ai-frame-gif.svg" alt="" style="left:25px;top:319px;width:78px;height:78px" />
        <div class="b-chip" style="left:24px;top:240px;width:114px;transform:rotate(-55deg)"><i></i><span>Rewrite</span></div>
        <div class="b-chip" style="left:97px;top:168px;width:140px;transform:rotate(-23deg)"><span>Adjust length</span></div>
        <img class="b-abs" src="/images/ai-camera-button.png" alt="AssessPrep AI camera" style="left:109px;top:239px;width:77px;height:77px" />
      </div>

      <img class="b-abs b-ring" src="/images/ai-code-ring.svg" alt="" style="left:416px;top:267px;width:368px;height:368px" />
    </div>
  </div>
</section>

<style>
  .ai { background: var(--c-navy); padding: 100px 20px 125px; overflow: hidden; }
  .ai__head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ai__badge {
    padding: 1px; border-radius: 100px;
    background: linear-gradient(180deg, #ff2f2f 0%, #ef7b16 35.9%, #8a43e1 69.9%, #d511fd 100%);
  }
  .ai__badge span {
    display: block; padding: 10px 14px; border-radius: 100px; background: #1e1e1e;
    font-family: var(--font-display); font-weight: 500; font-size: 16px; line-height: 24px; color: #fff;
  }
  .ai__title { margin-top: 10px; font-family: var(--font-heading); font-weight: 600; font-size: 48px; line-height: 1.4; letter-spacing: -0.04em; color: #fff; }
  .ai__sub { margin-top: 15px; max-width: 650px; font-family: var(--font-display); font-weight: 500; font-size: 16px; line-height: 1.5; color: #ded8d3; }
  .ai__btn {
    margin-top: 14px; display: inline-flex; align-items: center; height: 55px; padding: 0 20px; border-radius: 8px; background: #fff;
    font-family: var(--font-display); font-weight: 500; font-size: 18px; color: #1e1e1e; transition: background .2s ease;
  }
  .ai__btn:hover { background: #ecebf3; }

  .bento-wrap { --s: 1; position: relative; width: 1200px; max-width: 100%; height: calc(900px * var(--s)); margin: 80px auto 0; }
  .bento { position: absolute; left: 50%; top: 0; width: 1200px; height: 900px; transform: translateX(-50%) scale(var(--s)); transform-origin: top center; }
  .bento .b-card, .bento .b-abs { position: absolute; }
  .b-card { border-radius: 24px; overflow: hidden; }
  .b-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .b-card > *:not(.b-bg) { position: absolute; }

  .b-grad-purple, .b-grad-white, .b-grad-orange { -webkit-background-clip: text; background-clip: text; color: transparent; }
  .b-grad-purple { background-image: linear-gradient(90deg, #f4f1ff 0%, #6633ee 100%); }
  .b-grad-white { background-image: linear-gradient(135deg, #fff 0%, #a99cfb 100%); }
  .b-grad-orange { background-image: linear-gradient(141deg, #ffb265 0%, #e9766f 49%, #c04350 100%); }
  .b-big { text-align: center; font-family: var(--font-heading); font-weight: 600; font-size: 50px; line-height: 56px; letter-spacing: -0.02em; }

  .b-toggle { left: 65px; top: 42px; width: 132px; height: 72px; border-radius: 9999px; background: rgba(0,0,0,.15); box-shadow: rgba(0,0,0,.3) 0 0 23.6px inset; }
  .b-knob { position: absolute; left: 8px; top: 8px; width: 56px; height: 56px; border-radius: 9999px; box-shadow: rgba(0,0,0,.2) 0 0 26px -5px; transition: transform .6s cubic-bezier(.65,0,.35,1); }
  .b-knob img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 9999px; }
  .b-knob .b-knob__icon { inset: auto; left: 16px; top: 16px; width: 24px; height: 25px; border-radius: 0; }

  .b-prompt { display: flex; align-items: center; height: 40px; width: 198px; }
  .b-prompt span {
    flex: 1; height: 40px; margin: 0 -5px; display: grid; place-items: center;
    background: linear-gradient(90deg, rgba(177,147,255,.1) 0%, rgba(78,43,172,.2) 100%);
    font-family: var(--font-heading); font-size: 18px; line-height: 28px; color: #b1a0fc; white-space: nowrap;
  }
  .b-bracket { position: relative; z-index: 1; width: 10px; height: 40px; flex: none; }
  .b-bracket--r { transform: scaleX(-1); }

  .b-sphere { position: absolute; left: 430px; top: 279px; width: 340px; height: 340px; }
  .b-sphere img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .b-sphere__glow { opacity: .3; }
  .b-sphere__img { animation: spin 40s linear infinite; }
  .b-ring { animation: spin 60s linear infinite reverse; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .b-auth { left: 32px; top: 94px; width: 205px; font-family: var(--font-heading); font-weight: 600; font-size: 36px; line-height: 40px; letter-spacing: -0.01em; }
  .b-txt__t { font-family: var(--font-heading); font-weight: 700; font-size: 18px; line-height: 28px; color: #e6e3ff; }
  .b-txt__d { margin-top: 4px; font-family: var(--font-heading); font-size: 16px; line-height: 24px; color: #ac9fe4; }

  .b-saved { left: 0; right: 0; top: 89px; text-align: center; font-family: var(--font-heading); font-size: 18px; line-height: 28px; color: #b1a0fc; }
  .b-avatars { left: 45px; top: 133px; display: flex; align-items: center; }
  .b-av { width: 56px; height: 56px; border-radius: 9999px; }
  .b-av--star { width: 60px; height: 60px; }

  .b-gen { left: 32px; top: 46px; width: 198px; height: 72px; border-radius: 10000px; background: rgba(16,9,43,.25); box-shadow: rgba(1,4,29,.5) 0 1px 3px inset, rgba(255,255,255,.07) 0 1px 1px; }
  .b-gen__btn { position: absolute; left: 8px; top: 8px; width: 182px; height: 56px; border-radius: 10000px; display: flex; align-items: center; gap: 6px; padding-left: 30px; box-shadow: rgba(0,0,0,.05) 0 4px 6px -2px, rgba(0,0,0,.1) 0 10px 15px -3px; font-family: var(--font-heading); font-weight: 500; font-size: 20px; line-height: 28px; color: #fff; }
  .b-gen__bg { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: inherit; }
  .b-gen__icon { position: relative; width: 25px; height: 24px; }
  .b-gen__btn span { position: relative; }

  .b-chip {
    display: flex; align-items: center; gap: 8px; height: 48px; padding: 0 16px; border-radius: 9999px;
    background: rgba(98,106,181,.21); transform-origin: center;
    font-family: var(--font-heading); font-weight: 500; font-size: 16px; line-height: 34px; color: #e9e5ff; white-space: nowrap;
  }
  .b-chip i { width: 11px; height: 11px; border-radius: 50%; background: #c883fb; flex: none; }
  .b-chip--v { width: 48px; height: 190px; padding: 0; flex-direction: column; justify-content: flex-end; gap: 10px; padding-bottom: 14px; background: rgba(98,106,181,.18); }
  .b-chip--v span { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 14px; letter-spacing: .03em; color: #ddd6ff; }
  .b-chip--v i { width: 10px; height: 10px; }

  @media (max-width: 809.98px) {
    .ai { padding: 40px 10px 40px; }
    .ai__title { font-size: 28px; letter-spacing: -0.04em; margin-top: 14px; }
    .ai__sub { max-width: 312px; margin-top: 10px; }
    .ai__btn { margin-top: 14px; height: 52px; }
    .bento-wrap { margin-top: 30px; }
  }
</style>

<script>
  // Scale the 1200x900 bento to the available width (Framer does the same on smaller breakpoints).
  const wrap = document.querySelector<HTMLElement>('[data-bento-wrap]');
  if (wrap) {
    const fit = () => wrap.style.setProperty('--s', String(Math.min(1, wrap.clientWidth / 1200)));
    new ResizeObserver(fit).observe(wrap);
    fit();
  }
</script>
