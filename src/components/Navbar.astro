---
import { MENUS, PLANS, BOOK_DEMO, SIGN_IN, SITE } from '../data/site';
---
<header class="nav" data-nav>
  <!-- Desktop / tablet floating bar -->
  <nav class="nav__bar" aria-label="Main">
    <a class="nav__brand" href={SITE + '/'} aria-label="AssessPrep home">
      <img src="/images/logo-mark-nav.svg" alt="AssessPrep logo" width="30" height="30" />
      <span class="nav__wordmark">AssessPrep</span>
    </a>
    <ul class="nav__menu">
      {MENUS.map((m) => (
        <li class="nav__item" data-dropdown>
          <button class="nav__link" type="button" aria-expanded="false">
            <span>{m.label}</span>
            <img class="nav__chev" src="/icons/chevron-down.svg" alt="" width="14" height="14" />
          </button>
          <div class="dd" style={`--accent:${m.accent}`}>
            <div class="dd__panel">
              <p class="dd__heading">{m.heading}</p>
              <ul class="dd__list">
                {m.items.map((it) => (
                  <li>
                    <a class="dd__row" href={it.href}>
                      <span class="dd__icon"><img src={`/icons/nav/${it.icon}.svg`} alt="" width="22" height="22" /></span>
                      <span class="dd__text">
                        <span class="dd__title">{it.title}</span>
                        <span class="dd__sub">{it.sub}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
      <li class="nav__item"><a class="nav__link" href={PLANS}>Plans</a></li>
    </ul>
    <div class="nav__cta">
      <a class="btn-teal btn-teal--sm" href={BOOK_DEMO}>Book a Demo</a>
      <a class="nav__signin" href={SIGN_IN}>
        <img src="/icons/sign-in.svg" alt="" width="18" height="18" />
        <span>Sign in</span>
      </a>
    </div>
  </nav>

  <!-- Mobile bar -->
  <nav class="mnav" aria-label="Main mobile">
    <div class="mnav__top">
      <a class="nav__brand" href={SITE + '/'} aria-label="AssessPrep home">
        <img src="/images/logo-mark-nav.svg" alt="AssessPrep logo" width="30" height="30" />
        <span class="nav__wordmark">AssessPrep</span>
      </a>
      <button class="mnav__toggle" type="button" aria-label="Open menu" aria-expanded="false" data-mnav-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mnav__panel" data-mnav-panel>
      <ul class="mnav__list">
        {MENUS.map((m) => (
          <li>
            <details class="mnav__group">
              <summary>{m.mobileLabel ?? m.label}<img src="/icons/chevron-down.svg" alt="" width="14" height="14" /></summary>
              <ul>
                {m.items.map((it) => <li><a href={it.href}>{it.title}</a></li>)}
              </ul>
            </details>
          </li>
        ))}
        <li><a class="mnav__plain" href={PLANS}>Plans</a></li>
      </ul>
      <div class="mnav__cta">
        <a class="btn-teal btn-teal--sm" href={BOOK_DEMO}>Book a Demo</a>
        <a class="nav__signin" href={SIGN_IN}><img src="/icons/sign-in.svg" alt="" width="18" height="18" /><span>Sign in</span></a>
      </div>
    </div>
  </nav>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; pointer-events: none; }
  .nav > * { pointer-events: auto; }

  .nav__bar {
    position: relative;
    margin: 20px auto 0;
    width: min(1200px, calc(100% - 40px));
    height: 70px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 15px;
    transition: width .45s cubic-bezier(.4,0,.2,1), border-radius .45s ease, padding .45s ease;
  }
  .nav.is-compact .nav__bar { width: min(870px, calc(100% - 40px)); border-radius: 40px; padding: 0 15px 0 25px; }

  .nav__brand { display: flex; align-items: center; gap: 8px; flex: none; }
  .nav__brand img { width: 30px; height: 30px; }
  .nav__wordmark {
    font-family: var(--font-heading); font-weight: 600; font-size: 24px; line-height: 36px;
    letter-spacing: -0.04em; color: #3f3f46; white-space: nowrap; overflow: hidden;
    max-width: 140px; transition: max-width .45s ease, opacity .3s ease;
  }
  .nav.is-compact .nav__bar .nav__wordmark { max-width: 0; opacity: 0; margin-left: -8px; }

  .nav__menu { display: flex; align-items: center; list-style: none; margin: 0 0 0 15px; padding: 0; gap: 4px; }
  .nav__item { position: relative; }
  .nav__link {
    display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 12px;
    border: 0; background: transparent; border-radius: 10px; cursor: pointer;
    font-family: var(--font-body); font-size: 14px; font-weight: 500; line-height: 21px; letter-spacing: 0.03em; color: var(--c-text);
    transition: background .2s ease;
  }
  .nav__item:hover > .nav__link, .nav__item.is-open > .nav__link { background: rgba(113,113,122,.1); }
  .nav__chev { width: 14px; height: 14px; transition: transform .25s ease; }
  .nav__item.is-open .nav__chev { transform: rotate(180deg); }

  .nav__cta { margin-left: auto; display: flex; align-items: center; gap: 16px; }
  .nav__signin {
    display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 24px; border-radius: 10px;
    background: #0d0d0d; color: #fff; font-family: var(--font-body); font-size: 14px; letter-spacing: 0.02em;
    box-shadow: rgba(255,255,255,.44) 0 .64px .64px -.94px inset, rgba(255,255,255,.41) 0 1.93px 1.93px -1.88px inset,
      rgba(255,255,255,.35) 0 5.1px 5.1px -2.8px inset, rgba(255,255,255,.15) 0 16px 16px -3.75px inset, rgba(0,0,0,.17) 0 .56px .56px;
  }
  .nav__signin img { width: 18px; height: 18px; }

  /* Dropdown */
  .dd {
    position: absolute; top: calc(100% + 25px); left: -10px; width: 310px;
    padding: 6px; background: #fff; border: 1px solid var(--c-border); border-radius: 22px;
    box-shadow: 0 10px 30px rgba(0,0,0,.06);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .2s ease, transform .2s ease, visibility .2s;
  }
  .dd::before { content: ''; position: absolute; left: 0; right: 0; top: -26px; height: 26px; } /* hover bridge */
  .nav__item.is-open .dd { opacity: 1; visibility: visible; transform: none; }
  .dd__panel { background: #f4f4f5; border-radius: 16px; overflow: hidden; }
  .dd__heading { padding: 18px 20px 15px; font-family: var(--font-body); font-size: 12px; color: var(--c-muted); letter-spacing: .02em; border-bottom: 1px solid var(--c-border); }
  .dd__list { list-style: none; margin: 0; padding: 14px 0 12px; }
  .dd__row { display: flex; align-items: center; gap: 13px; padding: 15px 28px; }
  .dd__row:hover .dd__title { text-decoration: underline; }
  .dd__icon {
    width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 9px;
    background: color-mix(in srgb, var(--accent) 12%, #fff);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, #fff);
    box-shadow: 0 2px 4px rgba(0,0,0,.08);
  }
  .dd__text { display: flex; flex-direction: column; gap: 2px; }
  .dd__title { font-family: var(--font-inter); font-size: 14px; font-weight: 500; color: #000; }
  .dd__sub { font-family: var(--font-inter); font-size: 12px; color: #525252; }

  @media (max-width: 1199.98px) { .nav__bar { display: none; } }
  @media (min-width: 1200px) { .mnav { display: none; } }

  /* Mobile */
  .mnav { background: #fff; border-bottom: 1px solid var(--c-border); }
  .mnav__top { height: 64px; padding: 0 20px; display: flex; align-items: center; justify-content: space-between; }
  .mnav__toggle { width: 32px; height: 32px; border: 0; background: none; padding: 4px 3px; display: flex; flex-direction: column; justify-content: center; gap: 6px; cursor: pointer; }
  .mnav__toggle span { display: block; height: 2.5px; border-radius: 2px; background: #18181b; transition: transform .25s ease, opacity .2s ease; }
  .mnav__toggle span:nth-child(2) { width: 80%; }
  .mnav.is-open .mnav__toggle span:nth-child(1) { transform: translateY(8.5px) rotate(45deg); }
  .mnav.is-open .mnav__toggle span:nth-child(2) { opacity: 0; }
  .mnav.is-open .mnav__toggle span:nth-child(3) { transform: translateY(-8.5px) rotate(-45deg); }
  .mnav__panel { display: none; padding: 6px 20px 24px; max-height: calc(100vh - 64px); overflow: auto; }
  .mnav.is-open .mnav__panel { display: block; }
  .mnav__list { list-style: none; margin: 0; padding: 0; }
  .mnav__group summary, .mnav__plain {
    display: flex; align-items: center; justify-content: space-between; padding: 5px 0; list-style: none; cursor: pointer;
    font-family: var(--font-body); font-size: 14px; line-height: 25.2px; letter-spacing: .02em; color: var(--c-muted);
  }
  .mnav__group summary::-webkit-details-marker { display: none; }
  .mnav__group[open] summary img { transform: rotate(180deg); }
  .mnav__group ul { list-style: none; margin: 0 0 6px; padding: 0 0 0 12px; }
  .mnav__group ul a { display: block; padding: 6px 0; font-size: 14px; color: var(--c-text); font-family: var(--font-body); }
  .mnav__cta { display: flex; gap: 12px; margin-top: 16px; }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => nav.classList.toggle('is-compact', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Desktop dropdowns: open on hover / focus / click
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((item) => {
    const btn = item.querySelector('button')!;
    let t: number | undefined;
    const open = () => { clearTimeout(t); document.querySelectorAll('[data-dropdown].is-open').forEach((o) => o !== item && o.classList.remove('is-open')); item.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); };
    const close = () => { t = window.setTimeout(() => { item.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); }, 120); };
    item.addEventListener('mouseenter', open);
    item.addEventListener('mouseleave', close);
    item.addEventListener('focusin', open);
    item.addEventListener('focusout', (e) => { if (!item.contains(e.relatedTarget as Node)) close(); });
    btn.addEventListener('click', () => (item.classList.contains('is-open') ? close() : open()));
  });

  // Mobile menu
  const mnav = document.querySelector<HTMLElement>('.mnav')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-mnav-toggle]')!;
  toggle.addEventListener('click', () => {
    const open = mnav.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
